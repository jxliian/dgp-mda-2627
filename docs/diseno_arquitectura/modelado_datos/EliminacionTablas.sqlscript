-- Script para eliminar todas las tablas en PostgreSQL
DROP TABLE IF EXISTS canteen_stud CASCADE;
DROP TABLE IF EXISTS stud_task CASCADE;
DROP TABLE IF EXISTS par_stud CASCADE;
DROP TABLE IF EXISTS staff_stud CASCADE;

DROP TABLE IF EXISTS Steps CASCADE;
DROP TABLE IF EXISTS Canteen_Task CASCADE;
DROP TABLE IF EXISTS Generic_Task CASCADE;
DROP TABLE IF EXISTS Tasks CASCADE;
DROP TABLE IF EXISTS Alt_Tasks CASCADE;

DROP TABLE IF EXISTS Parents CASCADE;
DROP TABLE IF EXISTS Student CASCADE;
DROP TABLE IF EXISTS Avatar CASCADE;
DROP TABLE IF EXISTS Staff CASCADE;
DROP TABLE IF EXISTS Admn CASCADE;










