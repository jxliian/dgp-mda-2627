-- Alinea el almacenamiento de clases con Class(class_name), class_staff y class_stud.
-- Conserva clases y asociaciones creadas por las versiones anteriores del módulo.
CREATE TEMP TABLE migration_classes (
    class_name VARCHAR(50) PRIMARY KEY
);
CREATE TEMP TABLE migration_class_staff (
    class_name VARCHAR(50) NOT NULL,
    staff_usr_fk VARCHAR(50) NOT NULL,
    PRIMARY KEY (class_name, staff_usr_fk)
);
CREATE TEMP TABLE migration_class_stud (
    stud_usr_fk VARCHAR(50) PRIMARY KEY,
    class_name VARCHAR(50) NOT NULL
);

DO $$
BEGIN
    IF to_regclass('public.school_classes') IS NOT NULL THEN
        EXECUTE 'INSERT INTO pg_temp.migration_classes (class_name) '
             || 'SELECT class_name FROM school_classes ON CONFLICT DO NOTHING';
    END IF;
    IF to_regclass('public.class') IS NOT NULL THEN
        EXECUTE 'INSERT INTO pg_temp.migration_classes (class_name) '
             || 'SELECT class_name FROM Class ON CONFLICT DO NOTHING';
    END IF;
    IF to_regclass('public.student') IS NOT NULL AND EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = 'public' AND table_name = 'student' AND column_name = 'stud_class'
    ) THEN
        EXECUTE $sql$INSERT INTO pg_temp.migration_classes (class_name)
                 SELECT DISTINCT btrim(stud_class) FROM Student
                 WHERE stud_class IS NOT NULL AND btrim(stud_class) <> ''
                 ON CONFLICT DO NOTHING$sql$;
        EXECUTE $sql$INSERT INTO pg_temp.migration_class_stud (stud_usr_fk, class_name)
                 SELECT stud_usr, btrim(stud_class) FROM Student
                 WHERE stud_class IS NOT NULL AND btrim(stud_class) <> ''
                 ON CONFLICT DO NOTHING$sql$;
    END IF;

    IF to_regclass('public.class_staff') IS NOT NULL THEN
        IF EXISTS (
            SELECT 1 FROM information_schema.columns
            WHERE table_schema = 'public' AND table_name = 'class_staff' AND column_name = 'class_name_fk'
        ) THEN
            EXECUTE 'INSERT INTO pg_temp.migration_class_staff (class_name, staff_usr_fk) '
                 || 'SELECT class_name_fk, staff_usr_fk FROM class_staff ON CONFLICT DO NOTHING';
        ELSIF to_regclass('public.school_classes') IS NOT NULL THEN
            EXECUTE 'INSERT INTO pg_temp.migration_class_staff (class_name, staff_usr_fk) '
                 || 'SELECT c.class_name, a.staff_usr_fk FROM class_staff a '
                 || 'JOIN school_classes c ON c.class_id = a.class_id_fk ON CONFLICT DO NOTHING';
        END IF;
    END IF;

    IF to_regclass('public.class_stud') IS NOT NULL THEN
        IF EXISTS (
            SELECT 1 FROM information_schema.columns
            WHERE table_schema = 'public' AND table_name = 'class_stud' AND column_name = 'class_name_fk'
        ) THEN
            EXECUTE 'INSERT INTO pg_temp.migration_class_stud (stud_usr_fk, class_name) '
                 || 'SELECT stud_usr_fk, class_name_fk FROM class_stud ON CONFLICT DO NOTHING';
        END IF;
    ELSIF to_regclass('public.class_student') IS NOT NULL
          AND to_regclass('public.school_classes') IS NOT NULL THEN
        EXECUTE 'INSERT INTO pg_temp.migration_class_stud (stud_usr_fk, class_name) '
             || 'SELECT a.stud_usr_fk, c.class_name FROM class_student a '
             || 'JOIN school_classes c ON c.class_id = a.class_id_fk ON CONFLICT DO NOTHING';
    END IF;
END $$;

DROP TABLE IF EXISTS class_stud CASCADE;
DROP TABLE IF EXISTS class_student CASCADE;
DROP TABLE IF EXISTS class_staff CASCADE;
DROP TABLE IF EXISTS school_classes CASCADE;
DROP TABLE IF EXISTS Class CASCADE;

CREATE TABLE Class (
    class_name VARCHAR(50) PRIMARY KEY
);
CREATE TABLE class_staff (
    class_name_fk VARCHAR(50) NOT NULL,
    staff_usr_fk VARCHAR(50) NOT NULL,
    PRIMARY KEY (class_name_fk, staff_usr_fk),
    CONSTRAINT fk_class_staff_class FOREIGN KEY (class_name_fk) REFERENCES Class(class_name) ON UPDATE CASCADE ON DELETE CASCADE,
    CONSTRAINT fk_class_staff_staff FOREIGN KEY (staff_usr_fk) REFERENCES Staff(staff_usr) ON UPDATE CASCADE ON DELETE CASCADE
);
CREATE TABLE class_stud (
    class_name_fk VARCHAR(50) NOT NULL,
    stud_usr_fk VARCHAR(50) PRIMARY KEY,
    CONSTRAINT fk_class_stud_class FOREIGN KEY (class_name_fk) REFERENCES Class(class_name) ON UPDATE CASCADE ON DELETE CASCADE,
    CONSTRAINT fk_class_stud_student FOREIGN KEY (stud_usr_fk) REFERENCES Student(stud_usr) ON UPDATE CASCADE ON DELETE CASCADE
);

INSERT INTO Class (class_name) SELECT class_name FROM migration_classes;
INSERT INTO class_staff (class_name_fk, staff_usr_fk)
SELECT class_name, staff_usr_fk FROM migration_class_staff
ON CONFLICT DO NOTHING;
INSERT INTO class_stud (class_name_fk, stud_usr_fk)
SELECT class_name, stud_usr_fk FROM migration_class_stud
ON CONFLICT (stud_usr_fk) DO NOTHING;

-- El diagrama sitúa full_name en users y no define correo para administradores.
ALTER TABLE Admn DROP COLUMN IF EXISTS admn_email;

-- Normaliza los atributos de accesibilidad con los nombres del diagrama.
DO $$
BEGIN
    IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'student' AND column_name = 'stud_access_time_bar')
       AND NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'student' AND column_name = 'stud_access_timebar') THEN
        ALTER TABLE Student RENAME COLUMN stud_access_time_bar TO stud_access_timebar;
    END IF;
    IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'student' AND column_name = 'stud_access_tasks_mod')
       AND NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'student' AND column_name = 'stud_access_task_mod') THEN
        ALTER TABLE Student RENAME COLUMN stud_access_tasks_mod TO stud_access_task_mod;
    END IF;
END $$;

ALTER TABLE Student DROP COLUMN IF EXISTS stud_access_time_bar;
ALTER TABLE Student DROP COLUMN IF EXISTS stud_access_tasks_mod;

ALTER TABLE Student ADD COLUMN IF NOT EXISTS stud_access_prof_mod BOOLEAN;
UPDATE Student SET stud_access_prof_mod = FALSE WHERE stud_access_prof_mod IS NULL;
ALTER TABLE Student ALTER COLUMN stud_access_prof_mod SET NOT NULL;
ALTER TABLE Student DROP COLUMN IF EXISTS stud_class;

DROP TABLE migration_class_stud;
DROP TABLE migration_class_staff;
DROP TABLE migration_classes;
